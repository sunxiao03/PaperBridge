<Window x:Class="PaperBridge.App.DocumentOrganizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑文献归类"
        Width="470"
        Height="315"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#173247" Text="{Binding DocumentTitle}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Margin="0,18,0,6" Foreground="#53636E" Text="逻辑分类" />
        <ComboBox Grid.Row="2"
                  Height="32"
                  Padding="6,3"
                  ItemsSource="{Binding FolderChoices}"
                  SelectedItem="{Binding SelectedFolderChoice}"
                  DisplayMemberPath="Name" />
        <TextBlock Grid.Row="3" Margin="0,15,0,6" Foreground="#53636E" Text="标签（使用逗号或分号分隔）" />
        <TextBox Grid.Row="4" Height="32" Padding="7,4" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsFavorite}" Content="收藏此文献" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="76" Margin="0,0,8,0" IsCancel="True" Content="取消" />
                <Button Width="76" IsDefault="True" Click="ConfirmButton_Click" Content="保存" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
