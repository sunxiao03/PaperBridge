  <ItemGroup>
    <ProjectReference Include="../PaperBridge.Application/PaperBridge.Application.csproj" />
    <ProjectReference Include="../PaperBridge.Infrastructure/PaperBridge.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../LICENSE" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
