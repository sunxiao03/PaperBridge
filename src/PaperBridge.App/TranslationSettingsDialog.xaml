<Window x:Class="PaperBridge.App.TranslationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译服务设置"
        Width="560"
        Height="560"
        MinWidth="520"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#173247" Text="翻译服务" />
        <TextBlock Grid.Row="1" Margin="0,6,0,18" Foreground="#64727B" TextWrapping="Wrap"
                   Text="API Key 仅保存到 Windows Credential Manager；Base URL、模型和指令保存到本地设置文件。" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="服务商" />
            <ComboBox x:Name="ProviderComboBox"
                      Grid.Column="1"
                      Height="32"
                      SelectionChanged="ProviderComboBox_SelectionChanged">
                <ComboBoxItem Tag="openai" Content="OpenAI" />
                <ComboBoxItem Tag="deepseek" Content="DeepSeek" />
                <ComboBoxItem Tag="openai-compatible" Content="OpenAI 兼容服务" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Base URL" />
            <TextBox x:Name="BaseUrlTextBox" Grid.Column="1" Height="32" Padding="7,4" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="模型" />
            <TextBox x:Name="ModelTextBox" Grid.Column="1" Height="32" Padding="7,4" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="API Key" />
            <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="1" Height="32" Padding="7,4" />
            <Button Grid.Column="2" Margin="8,0,0,0" Click="DeleteKeyButton_Click" Content="删除密钥" />
        </Grid>

        <TextBlock x:Name="KeyStatusText" Grid.Row="6" Margin="110,6,0,0" FontSize="11" Foreground="#64727B" />

        <Grid Grid.Row="7" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="高级：自定义 AI 指令" />
            <TextBox x:Name="CustomInstructionTextBox"
                     Grid.Row="1"
                     Margin="0,6,0,0"
                     Padding="8"
                     MaxLength="8000"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="8" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="82" Margin="0,0,8,0" IsCancel="True" Content="取消" />
            <Button Width="82" IsDefault="True" Click="SaveButton_Click" Content="保存" />
        </StackPanel>
    </Grid>
</Window>
